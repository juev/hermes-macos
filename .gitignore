.DS_Store
build/
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/

# The global git ignore excludes AGENTS.md; these rules belong to the repository.
!AGENTS.md

# Generated by XcodeGen from project.yml, and by the build.
Hermes.xcodeproj/
.build/
*.xcresult

# The payloads of the contract are copied here by scripts/sync-fixtures.sh, never committed.
Core/Tests/HermesCoreTests/Fixtures/**
!Core/Tests/HermesCoreTests/Fixtures/.gitkeep
